# ===== Nguồn AI (giống nails-studio) — dùng lần lượt, nguồn lỗi/hết tiền thì tự chuyển sang nguồn sau =====
# Thứ tự: các project Vertex trước, rồi các key AI Studio. Chỉ dùng ở server, KHÔNG thêm tiền tố EXPO_PUBLIC_.

# Vertex AI (credit Google Cloud). Nhiều project cách nhau bằng dấu phẩy.
#  - "projA"               → dùng đăng nhập của máy (gcloud auth application-default login)
#  - "projB@C:\keys\b.json" → dùng file khoá service account riêng
# GOOGLE_CLOUD_PROJECT=projA,projB@C:\keys\b.json
# GOOGLE_CLOUD_LOCATION=global

# Google AI Studio. Nhiều key cách nhau bằng dấu phẩy.
GEMINI_API_KEY=

# Claude (Anthropic) viết bài blog trên trang quản trị. Lấy ở console.anthropic.com. Chỉ dùng ở server.
# Tên riêng của Camia (không dùng ANTHROPIC_API_KEY) để không lấy nhầm khoá chung của máy.
CAMI_CLAUDE_API_KEY=

# Model mặc định khi app không gửi lựa chọn. Người dùng chọn Flash hoặc Pro trong app; Pro bận thì tự lùi về Flash.
#   gemini-3-pro-image          đẹp nhất, ~0.134 USD/ảnh
#   gemini-3.1-flash-image      cân bằng, ~0.067 USD/ảnh (mặc định khi để trống)
GEMINI_IMAGE_MODEL=gemini-3-pro-image

# Chuỗi bí mật ngẫu nhiên để băm IP khách (đặt khi chạy thật). Tài khoản + điểm lưu ở data/cami.db (đổi chỗ bằng CAMI_DATA_DIR)
CAMI_SECRET=
# Múi giờ làm mới điểm tháng (tên IANA). Mặc định Argentina/Brazil GMT-3. VD: America/Bogota, America/Santiago
CAMI_TIMEZONE=America/Argentina/Buenos_Aires

# Email các tài khoản Cami được vào trang quản trị /admin (cách nhau bằng dấu phẩy). Đăng nhập bằng tài khoản đó như khách bình thường.
ADMIN_EMAILS=

# Tùy chọn: mã bí mật để chặn người lạ gọi API của bạn (phải trùng EXPO_PUBLIC_APP_TOKEN)
APP_TOKEN=

# Port của server.cjs khi chạy trên VPS (mặc định 3010). Chọn port chưa có dự án nào dùng, và ghi cùng số trong nginx.
# PORT=3020

# ===== Phía app =====
EXPO_PUBLIC_APP_TOKEN=
# Số lượt AI mỗi ngày trên mỗi máy
# Để trống khi chạy dev. Khi build app thật, đặt URL server đã deploy (vd https://cami.expo.app)
# Địa chỉ web công khai của Cami, dùng trong link mời bạn bè (VD: https://cami.tenmien.com)
EXPO_PUBLIC_SHARE_URL=
EXPO_PUBLIC_API_URL=
