{
  "expo": {
    "name": "CamIA",
    "slug": "cami",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "cami",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hieplevan.cami"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF6F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "app.camia",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "versionCode": 2
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://camia.app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAF6F0"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cami cần quyền xem ảnh để bạn chọn ảnh chỉnh sửa.",
          "cameraPermission": "Cami cần dùng camera để chụp ảnh.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Cami cần quyền lưu ảnh vào thư viện.",
          "savePhotosPermission": "Cami cần quyền lưu ảnh đã chỉnh vào thư viện.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-localization",
      "./plugins/withReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {
        "origin": "https://camia.app"
      },
      "eas": {
        "projectId": "ff52b0fe-a76b-4a42-9843-aac6bbf23280"
      }
    },
    "owner": "hieplevan"
  }
}
